# Nuxt product API
NUXT_HOST=0.0.0.0
NUXT_PORT=3000
NUXT_PUBLIC_APP_NAME=CropMerge Field Triage

# Browser -> Vision API. Local development uses localhost; Vercel uses the
# stable Cloudflare Tunnel hostname. Never put the shared secret under NUXT_PUBLIC_.
NUXT_PUBLIC_VISION_API_URL=http://127.0.0.1:8001
NUXT_PUBLIC_VISION_SMALL_UPLOAD_THRESHOLD_BYTES=25165824
NUXT_VISION_SHARED_SECRET=CHANGE_ME_TO_A_RANDOM_32_BYTE_SECRET
# Optional extra allowed browser origins for the session endpoint. The current
# Nuxt origin is always allowed.
NUXT_VISION_SESSION_ORIGINS=

# Internal vision engine (Python FastAPI)
VISION_SERVICE_URL=http://127.0.0.1:8001
VISION_TIMEOUT_MS=600000
# Set this only for a legacy local integration test. It is intentionally unset
# for Vercel, where media must never traverse a serverless route.
# NUXT_ENABLE_LEGACY_LOCAL_PROXY=true

# Vision server deployment settings. These are read by FastAPI, not exposed to
# the browser. Set VISION_SHARED_SECRET to exactly the same value as
# NUXT_VISION_SHARED_SECRET.
VISION_SHARED_SECRET=CHANGE_ME_TO_THE_SAME_RANDOM_32_BYTE_SECRET
VISION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VISION_HOST=127.0.0.1
VISION_PORT=8001
# Required in production so signed artifact links always use the stable tunnel hostname.
VISION_PUBLIC_BASE_URL=http://127.0.0.1:8001
VISION_DATA_DIR=./data
VISION_UPLOAD_DIR=./data/uploads
VISION_OUTPUT_DIR=./outputs
VISION_JOB_DATABASE_PATH=./data/db/vision-jobs.sqlite
VISION_UPLOAD_CHUNK_BYTES=8388608
VISION_SMALL_UPLOAD_THRESHOLD_BYTES=25165824
VISION_MAX_UPLOAD_BYTES=10737418240
VISION_ARTIFACT_TOKEN_TTL_SECONDS=3600

# Structured JSON access log for browser / Cloudflare traffic (rotates at 20MB)
VISION_API_LOG_PATH=./deploy/local/vision-api.log
VISION_ACCESS_LOG_LEVEL=INFO

# Shared storage (relative to monorepo root)
DATA_DIR=./data
OUTPUTS_DIR=./outputs
UPLOADS_DIR=./data/uploads

# ── Local databases ──────────────────────────────────────────
# Default: SQLite files (run: bash scripts/init-local-dbs.sh)
DATABASE_DIR=./data/db
DATABASE_URL=sqlite:///./data/db/cropmerge.sqlite
NUXT_DATABASE_URL=sqlite:///./data/db/cropmerge.sqlite
VISION_DATABASE_URL=sqlite:///./data/db/vision.sqlite

# Optional Postgres (docker compose up -d postgres)
# DATABASE_URL=postgresql://cropmerge:cropmerge@127.0.0.1:5432/cropmerge
# VISION_DATABASE_URL=postgresql://cropmerge:cropmerge@127.0.0.1:5432/cropmerge_vision

# Vision runtime + weights (see apps/vision/models/weights.env)
CROP_MERGE_DEVICE=auto
# Bind to free GPU when multiple cards present (see deploy/local/vision.env)
# CUDA_VISIBLE_DEVICES=1
CROP_MERGE_SEGMENTATION_BACKEND=field_cv
CROP_MERGE_DINO_BACKEND=auto
# Faster drone clip defaults (override in deploy/local/vision.env)
CROP_MERGE_MAX_FRAMES=24
CROP_MERGE_SAMPLE_FPS=2
# After download_weights.py:
#   set -a; source apps/vision/models/weights.env; set +a
# CROP_MERGE_SEGMENTATION_BACKEND=sam2
# SAM2_CHECKPOINT=./apps/vision/models/sam2.1_hiera_small.pt
# CROP_MERGE_DINO_BACKEND=dinov2
# DINOV2_CHECKPOINT=./apps/vision/models/dinov2_vitb14_pretrain.pth
# Gated (HF_TOKEN + license):
# CROP_MERGE_SEGMENTATION_BACKEND=sam3
# SAM3_CHECKPOINT=
# CROP_MERGE_DINO_BACKEND=dinov3
# DINOV3_CHECKPOINT=

# Optional local-LLM prose enrichment for Inspection Area descriptions
# (pip install -e '.[llm-enrichment]'). Off by default — never fabricates
# a summary; falls back to the existing heuristic `reasons` text.
CROP_MERGE_LLM_ENRICHMENT=false
# CROP_MERGE_LLM_MODEL_PATH=/path/to/a/local/instruct-model/snapshot
# CROP_MERGE_LLM_DEVICE=cuda:1

# ── Live Drone mode (docker compose up --build only, see AGENTS.md) ──
# Browser -> MediaMTX WHEP. Leave empty to keep Live Drone mode disabled
# (e.g. on Vercel, which cannot host a persistent WHEP/MQTT connection).
NUXT_PUBLIC_MEDIAMTX_WHEP_URL=http://127.0.0.1:8889
LIVE_STREAM_PATH=cropmerge/live
# apps/vision -> MediaMTX/Mosquitto. Compose overrides these to the
# in-network service hostnames (mediamtx, mosquitto); these are the
# native/nohup defaults.
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554/cropmerge/live
MEDIAMTX_RTMP_URL=rtmp://127.0.0.1:1935/cropmerge/live
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
LIVE_SAMPLE_FPS_DEFAULT=2
LIVE_SAMPLE_FPS_MAX=5
